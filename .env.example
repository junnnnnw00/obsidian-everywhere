# Copy to .env and fill in. Never commit the real .env file.

# Absolute path to your Obsidian vault on the host machine.
OBSIDIAN_VAULT_HOST_PATH=/absolute/path/to/your/vault

# Beta: protect persistent indexes on removable/network/container mounts.
# Opt in only when an empty vault is not a legitimate steady state.
OBSIDIAN_EVERYWHERE_MOUNT_GUARD=false
# Optional but strongly recommended: an existing vault-relative path that
# uniquely proves the intended mount is present.
OBSIDIAN_EVERYWHERE_MOUNT_SENTINEL=.obsidian/app.json
# OBSIDIAN_EVERYWHERE_MOUNT_RECHECK_MS=5000

# Static bearer token for remote MCP clients. Use only over a private network
# or a TLS-terminating tunnel; never expose the plaintext local port publicly.
# Generate one with: openssl rand -hex 32
OBSIDIAN_EVERYWHERE_TOKEN=

# Write tools are ON by default for this service. Set to
# "true" to make it read-only instead.
# OBSIDIAN_EVERYWHERE_READONLY=true

# --- Vault Git tools (always opt-in, separate per Compose service) ---
# off: no Git tools (default)
# read: git_status, git_diff, git_log
# commit: read tools + preview/approval git_commit
# push: commit tools + preview/approval git_push
# Bearer HTTP service:
OBSIDIAN_EVERYWHERE_HTTP_GIT_MODE=off

# Operator-selected vault-relative real repository directory. Keep "." when the
# entire vault is one repository; use a fixed subfolder such as DSLab when only
# that folder is Git-backed. The full vault is still indexed.
OBSIDIAN_EVERYWHERE_HTTP_GIT_REPO_PATH=.

# Required only when the bearer service uses push mode. Use comma-separated
# exact name=credential-free-HTTPS-URL mappings, for example:
# origin=https://github.com/owner/vault.git
OBSIDIAN_EVERYWHERE_HTTP_GIT_ALLOWED_PUSH_REMOTES=

# --- claude.ai connector (OAuth) service — only needed if you use it ---

# Public HTTPS origin this server is reachable at, e.g. your Cloudflare
# Tunnel hostname: https://obsidian.example.com
OAUTH_ISSUER_URL=

# Single-user login secret entered on the connector's sign-in page.
# Generate one with: openssl rand -hex 32
OAUTH_LOGIN_SECRET=

# Write tools are OFF by default on this public-facing
# service. Set to "true" to enable them here too.
# OAUTH_ENABLE_WRITE_TOOLS=true

# Keep the public OAuth connector's Git capability separate. It defaults to off
# even when the bearer service enables Git. OAuth commit/push requires BOTH
# OAUTH_ENABLE_WRITE_TOOLS=true and an OAuth Git mode of commit/push.
OBSIDIAN_EVERYWHERE_OAUTH_GIT_MODE=off
OBSIDIAN_EVERYWHERE_OAUTH_GIT_REPO_PATH=.
OBSIDIAN_EVERYWHERE_OAUTH_GIT_ALLOWED_PUSH_REMOTES=

# Direct CLI/LaunchAgent processes use OBSIDIAN_EVERYWHERE_GIT_MODE,
# OBSIDIAN_EVERYWHERE_GIT_REPO_PATH, and
# OBSIDIAN_EVERYWHERE_GIT_ALLOWED_PUSH_REMOTES instead of these Compose inputs.
